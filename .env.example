# Environment variable template — commit this file, never commit .env.
# Copy to .env and fill in your values.
# Loaded automatically by pydantic-settings on server startup (no `source` needed).
#
# Format:  KB_<SECTION>__<KEY>=value   (prefix KB_, nested delimiter __)
# Full schema: src/kb/config.py        Full docs: README.md § Configuration

# ── LLM / AI Chat (required to enable /api/v1/chat and /api/v1/extract) ───────
KB_LLM__API_KEY=sk-********************************   # DashScope — dashscope.aliyuncs.com (same key as embedding)
# KB_LLM__API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions  # default
# KB_LLM__MODEL=qwen-plus
# KB_LLM__MAX_TOKENS=1200
# KB_LLM__TIMEOUT_S=20                      # default chat read-timeout (seconds)
# KB_LLM__EXTRACT_TIMEOUT_S=10              # shorter budget for /extract
# KB_LLM__MAX_RETRIES=2                     # retries on transient 429 / 5xx / timeout

# ── Elasticsearch ─────────────────────────────────────────────────────────────
# KB_ES__URL=http://localhost:9200          # plain HTTP; docker-compose default
# KB_ES__USERNAME=elastic                   # only needed for secured clusters
# KB_ES__PASSWORD=                          # override instead of editing settings.yaml
# KB_ES__SSL_FINGERPRINT=                   # SHA-256 of the server TLS cert (HTTPS clusters)
# KB_ES__VERIFY_CERTS=false                 # set false for self-signed certs in dev
# KB_ES__ANALYZER_INDEX=cjk                 # fallback if IK plugin is not installed (default: ik_max_word)
# KB_ES__ANALYZER_QUERY=cjk                 # fallback if IK plugin is not installed (default: ik_smart)

# ── Embedding service (OpenAI-compatible API, e.g. DashScope) ────────────────
KB_EMBEDDING__API_KEY=sk-********************************   # DashScope — dashscope.aliyuncs.com
# KB_EMBEDDING__URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# KB_EMBEDDING__MODEL=text-embedding-v3
# KB_EMBEDDING__DIMS=1024
# KB_EMBEDDING__TIMEOUT_S=30

# ── Server ────────────────────────────────────────────────────────────────────
# KB_SERVER__PORT=8000                       # change to run multiple instances side-by-side
# KB_SERVER__HOST=0.0.0.0

# ── Search tuning ─────────────────────────────────────────────────────────────
# KB_SEARCH__STRICT_MAX_HITS=8             # results above this → TOO_MANY status
# KB_SEARCH__TITLE_BOOST=3.0              # title field weight vs body (BM25)
# KB_SEARCH__RRF_WINDOW=50                 # candidates rescored with BM25+vector
# KB_SEARCH__VECTOR_WEIGHT=0.5             # vector vs BM25 weight in final score (0–1)

# ── File ingestion ────────────────────────────────────────────────────────────
# KB_INGEST__UPLOAD_DIR=data/uploads        # where uploaded files are persisted
# KB_INGEST__SCAN_ROOT=data                 # server-side folder scans confined to this root
# KB_INGEST__MAX_FILE_SIZE_MB=50            # max upload size per file
# KB_INGEST__PDF_MAX_PAGES=2000             # reject PDFs with more pages (guards against OOM)
# KB_INGEST__XLSX_MAX_CELLS=2000000         # reject spreadsheets exceeding this cell count
# KB_INGEST__OCR_ENABLED=true               # enable PaddleOCR fallback for scanned PDFs
# KB_INGEST__OCR_LANG=ch                    # PaddleOCR model (ch also reads English; en = English-only)
# KB_INGEST__OCR_MIN_CONFIDENCE=0.5         # drop OCR lines below this confidence
# KB_INGEST__SEGMENTATION_MAX_TOKENS=8000   # max LLM response tokens for segmentation
# KB_INGEST__SEGMENTATION_CHUNK_CHARS=12000 # characters per LLM segmentation chunk
# KB_INGEST__SESSION_TTL_MINUTES=120        # auto-expire committed/failed sessions after N minutes
# KB_INGEST__SESSION_HARD_TTL_MINUTES=480   # evict any session (incl. in-flight) after N minutes
# KB_INGEST__SESSION_EVICT_INTERVAL_MINUTES=15  # how often the background sweeper reclaims expired sessions

# ── Observability ─────────────────────────────────────────────────────────────
# KB_OBSERVABILITY__METRICS_ENABLED=true    # expose GET /metrics (Prometheus text)
# KB_OBSERVABILITY__JSON_LOGS=false         # true → one JSON object per log line
# KB_OBSERVABILITY__LOG_LEVEL=INFO
